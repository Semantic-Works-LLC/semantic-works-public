# Python virtual environment with the test tools (recreate with `make setup`)
.venv/

# Python caches
__pycache__/
*.py[cod]

# Test and coverage output (recreate with `make test`)
.pytest_cache/
.coverage
.coverage.*
coverage/

# Personal Claude Code settings (shared project config in .claude/ stays tracked)
.claude/settings.local.json

# macOS and editor clutter
.DS_Store
.idea/
.vscode/
*.swp

# Note: tests/screenshots/*.png are deliberately NOT ignored. They are checked in
# so that changes to the look of the page show up in version control.
